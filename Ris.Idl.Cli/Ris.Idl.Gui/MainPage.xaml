<Page x:Class="Ris.Idl.Gui.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:viewModel="using:Ris.Idl.Gui.ViewModel"
      xmlns:views="using:Ris.Idl.Gui.Views"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    
    <Page.DataContext>
        <viewModel:MainViewModel x:Name="ViewModel" />
    </Page.DataContext>

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="Ris.Idl - C# to TypeScript Generator"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Generate TypeScript types from your C# project"
                       FontSize="14"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>

        <!-- Generator View -->
        <views:GeneratorView Grid.Row="1" 
                             DataContext="{Binding}" />

        <!-- Output Log View -->
        <views:OutputLogView Grid.Row="2" 
                             DataContext="{Binding}"
                             Margin="0,24,0,0" />
    </Grid>
</Page>
