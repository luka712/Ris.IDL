<UserControl
    x:Class="Ris.Idl.Gui.Controls.SelectProjectButton"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

    <Grid ColumnDefinitions="120, Auto" Margin="10, 10, 0,0">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left">
            Select Project
        </TextBlock>
        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBox PlaceholderText="Add .sln or .csproj file"  
                             Text="{Binding Project, ElementName=Root, Mode=TwoWay}"  />
                    <Button Click="ButtonBase_OnClick" Margin="5, 0,0,0">
                        <SymbolIcon Symbol="Folder" />
                    </Button>
                </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>