<UserControl
    x:Class="Ris.Idl.Gui.Views.GeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:Ris.Idl.Gui.Converters"
    xmlns:models="using:Ris.Idl.Gui.Models"
    mc:Ignorable="d"
    d:DesignHeight="400"
    d:DesignWidth="500">

    <UserControl.Resources>
        <converters:ProjectTypeDisplayConverter x:Key="ProjectTypeDisplayConverter" />
        <converters:BoolNegationConverter x:Key="BoolNegationConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Project Type Selection -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Project Type" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ComboBox x:Name="ProjectTypeComboBox"
                      ItemsSource="{Binding ProjectTypes}"
                      SelectedItem="{Binding SelectedProjectType, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MinWidth="400">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ProjectType">
                        <TextBlock Text="{Binding Converter={StaticResource ProjectTypeDisplayConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Input Project Selection -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="C# Project File (.csproj)" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectPathTextBox"
                         Grid.Column="0"
                         Text="{Binding ProjectPath, Mode=TwoWay}"
                         PlaceholderText="Select a .csproj file..."
                         IsReadOnly="True"
                         Margin="0,0,8,0" />
                <Button x:Name="BrowseProjectButton"
                        Grid.Column="1"
                        Content="Browse..."
                        Click="BrowseProjectButton_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                        MinWidth="100" />
            </Grid>
        </StackPanel>

        <!-- Output Folder Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,24">
            <TextBlock Text="Output Folder" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputFolderTextBox"
                         Grid.Column="0"
                         Text="{Binding OutputFolder, Mode=TwoWay}"
                         PlaceholderText="Select output folder..."
                         IsReadOnly="True"
                         Margin="0,0,8,0" />
                <Button x:Name="BrowseFolderButton"
                        Grid.Column="1"
                        Content="Browse..."
                        Click="BrowseFolderButton_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"
                        MinWidth="100" />
            </Grid>
        </StackPanel>

        <!-- Generate Button -->
        <Button x:Name="GenerateButton"
                Grid.Row="3"
                Content="Generate TypeScript"
                Command="{Binding GenerateCommand}"
                HorizontalAlignment="Center"
                Padding="32,12"
                FontSize="16" />

        <!-- Status -->
        <StackPanel Grid.Row="4" Margin="0,24,0,0">
            <TextBlock x:Name="StatusTextBlock"
                       Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />
            <ProgressRing x:Name="ProgressIndicator"
                          IsActive="{Binding IsBusy}"
                          HorizontalAlignment="Center"
                          Margin="0,16,0,0"
                          Width="40"
                          Height="40" />
        </StackPanel>
    </Grid>
</UserControl>
