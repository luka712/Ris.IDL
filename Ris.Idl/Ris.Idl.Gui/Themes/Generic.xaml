<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ris.Idl.Gui.Controls">

    <Style TargetType="local:LabelComboBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:LabelComboBox">
                    <Grid
                        ColumnDefinitions="120,*"
                        Margin="10">

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Text="{TemplateBinding Label}" />

                        <ComboBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            ItemsSource="{TemplateBinding ItemsSource}"
                            SelectedItem="{TemplateBinding SelectedItem}" />

                    </Grid>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:LabelFilePicker">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid ColumnDefinitions="120, *" Margin="10, 10, 0,0">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="{TemplateBinding Label}" />
                        <Grid Grid.Column="1" VerticalAlignment="Center"
                              ColumnDefinitions="*, Auto"
                                    HorizontalAlignment="Left">
                                <TextBox Text="{TemplateBinding FilePath}" PlaceholderText="..." />
                                <Button
                                    Grid.Column="1"
                                    x:Name="PART_Button"
                                    Margin="5, 0,0,0">
                                    <SymbolIcon Symbol="OpenFile" />
                                </Button>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:LabelFolderPicker">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid ColumnDefinitions="120, *" Margin="10, 10, 0,0">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Text="{TemplateBinding Label}" />
                        <Grid ColumnDefinitions="*,Auto" Grid.Column="1"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Vertical">
                                <TextBox Text="{TemplateBinding FolderPath, Mode=TwoWay}" PlaceholderText="..."
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Button HorizontalAlignment="Right"
                                    x:Name="PART_Button"
                                    Grid.Column="1"
                                    Margin="5, 0,0,0">
                                <SymbolIcon Symbol="Folder" />
                            </Button>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>